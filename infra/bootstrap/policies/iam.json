{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListIAMResources",
      "Effect": "Allow",
      "Action": ["iam:ListRoles", "iam:ListInstanceProfiles"],
      "Resource": "*"
    },
    {
      "Sid": "ReadNASCRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListInstanceProfilesForRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::242627333067:role/nasc-*"
    },
    {
      "Sid": "ReadNASCInstanceProfiles",
      "Effect": "Allow",
      "Action": ["iam:GetInstanceProfile"],
      "Resource": "arn:aws:iam::242627333067:instance-profile/nasc-*"
    },
    {
      "Sid": "ReadNASCPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::242627333067:policy/nasc-*",
        "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
      ]
    },
    {
      "Sid": "PassDevEC2Role",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::242627333067:role/nasc-dev-ec2-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}

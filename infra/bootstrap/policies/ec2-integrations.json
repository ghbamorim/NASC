{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAttachmentsBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::nasc-attachments-242627333067-*",
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "us-east-2"
        }
      }
    },
    {
      "Sid": "ManageAttachmentsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketVersioning",
        "s3:ListBucketVersions",
        "s3:GetBucketWebsite",
        "s3:GetBucketLogging",
        "s3:GetBucketCORS",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::nasc-attachments-242627333067-*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "242627333067"
        }
      }
    },
    {
      "Sid": "ManageAttachmentsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::nasc-attachments-242627333067-*/*",
        "arn:aws:s3:::nasc-terraform-state-242627333067-us-east-2/migrations/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "242627333067"
        }
      }
    },
    {
      "Sid": "ListMigrationBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nasc-terraform-state-242627333067-us-east-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["migrations", "migrations/*"]
        }
      }
    },
    {
      "Sid": "ListCloudFrontResources",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListDistributions",
        "cloudfront:ListCachePolicies",
        "cloudfront:ListVpcOrigins"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCloudFrontCachePolicies",
      "Effect": "Allow",
      "Action": "cloudfront:GetCachePolicy",
      "Resource": "*"
    },
    {
      "Sid": "CreateCloudFrontDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateDistributionWithTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageNASCDistributions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudfront::242627333067:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "NASC"
        }
      }
    },
    {
      "Sid": "ManageNASCCloudFrontFunctions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:DeleteFunction",
        "cloudfront:UpdateFunction"
      ],
      "Resource": "arn:aws:cloudfront::242627333067:function/nasc-*"
    },
    {
      "Sid": "ManageCloudFrontKeyValueStores",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateKeyValueStore",
        "cloudfront:DescribeKeyValueStore",
        "cloudfront:UpdateKeyValueStore",
        "cloudfront:DeleteKeyValueStore"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageCloudFrontKeyValues",
      "Effect": "Allow",
      "Action": [
        "cloudfront-keyvaluestore:DescribeKeyValueStore",
        "cloudfront-keyvaluestore:GetKey",
        "cloudfront-keyvaluestore:PutKey",
        "cloudfront-keyvaluestore:ListKeys"
      ],
      "Resource": "arn:aws:cloudfront::242627333067:key-value-store/*"
    },
    {
      "Sid": "ManageCloudFrontVpcOrigins",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateVpcOrigin",
        "cloudfront:GetVpcOrigin",
        "cloudfront:UpdateVpcOrigin",
        "cloudfront:DeleteVpcOrigin"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageCloudFrontNetworkInterfaces",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DeleteNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "ReadLoadBalancers",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeLoadBalancerAttributes",
        "elasticloadbalancing:DescribeTags",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetGroupAttributes",
        "elasticloadbalancing:DescribeTargetHealth",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeListenerAttributes",
        "elasticloadbalancing:DescribeRules",
        "elasticloadbalancing:DescribeAccountLimits"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "ManageNASCLoadBalancers",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": "arn:aws:elasticloadbalancing:us-east-2:242627333067:loadbalancer/app/nasc-*/*"
    },
    {
      "Sid": "ManageNASCTargetGroups",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:DeregisterTargets",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": "arn:aws:elasticloadbalancing:us-east-2:242627333067:targetgroup/nasc-*/*"
    },
    {
      "Sid": "ManageNASCListeners",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:ModifyListener",
        "elasticloadbalancing:ModifyListenerAttributes",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:us-east-2:242627333067:loadbalancer/app/nasc-*/*",
        "arn:aws:elasticloadbalancing:us-east-2:242627333067:listener/app/nasc-*/*/*"
      ]
    }
  ]
}

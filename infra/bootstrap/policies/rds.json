{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRDS",
      "Effect": "Allow",
      "Action": ["rds:Describe*", "rds:ListTagsForResource"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "ManageNASCDBInstances",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "rds:StartDBInstance",
        "rds:StopDBInstance",
        "rds:RebootDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot"
      ],
      "Resource": "arn:aws:rds:${region}:${account_id}:db:nasc-dev-*"
    },
    {
      "Sid": "ManageNASCDBSubnetGroups",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:DeleteDBSubnetGroup"
      ],
      "Resource": "arn:aws:rds:${region}:${account_id}:subgrp:nasc-dev-*"
    },
    {
      "Sid": "ManageNASCDBParameterGroups",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBParameterGroup",
        "rds:ModifyDBParameterGroup",
        "rds:ResetDBParameterGroup",
        "rds:DeleteDBParameterGroup"
      ],
      "Resource": "arn:aws:rds:${region}:${account_id}:pg:nasc-dev-*"
    },
    {
      "Sid": "ManageNASCDBSnapshots",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSnapshot",
        "rds:DeleteDBSnapshot",
        "rds:RestoreDBInstanceFromDBSnapshot"
      ],
      "Resource": [
        "arn:aws:rds:${region}:${account_id}:db:nasc-dev-*",
        "arn:aws:rds:${region}:${account_id}:snapshot:nasc-dev-*"
      ]
    },
    {
      "Sid": "UseNASCDBDependencies",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot"
      ],
      "Resource": [
        "arn:aws:rds:${region}:${account_id}:subgrp:nasc-dev-*",
        "arn:aws:rds:${region}:${account_id}:pg:nasc-dev-*",
        "arn:aws:rds:${region}:${account_id}:og:nasc-dev-*"
      ]
    },
    {
      "Sid": "UseDefaultPostgreSQLGroups",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot"
      ],
      "Resource": [
        "arn:aws:rds:${region}:${account_id}:pg:default.postgres*",
        "arn:aws:rds:${region}:${account_id}:og:default:postgres-*"
      ]
    },
    {
      "Sid": "ManageNASCRDSTags",
      "Effect": "Allow",
      "Action": ["rds:AddTagsToResource", "rds:RemoveTagsFromResource"],
      "Resource": [
        "arn:aws:rds:${region}:${account_id}:db:nasc-dev-*",
        "arn:aws:rds:${region}:${account_id}:subgrp:nasc-dev-*",
        "arn:aws:rds:${region}:${account_id}:pg:nasc-dev-*",
        "arn:aws:rds:${region}:${account_id}:snapshot:nasc-dev-*"
      ]
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAPIGateway",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:${region}::/*"
    }
  ]
}

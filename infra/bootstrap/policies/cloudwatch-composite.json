{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageCompositeAlarms",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutCompositeAlarm"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    }
  ]
}

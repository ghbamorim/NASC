{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTerraformState",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::nasc-terraform-state-${account_id}-${region}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["${environment}/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteTerraformState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::nasc-terraform-state-${account_id}-${region}/${environment}/terraform.tfstate"
    },
    {
      "Sid": "ManageTerraformStateLock",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::nasc-terraform-state-${account_id}-${region}/${environment}/terraform.tfstate.tflock"
    }
  ]
}

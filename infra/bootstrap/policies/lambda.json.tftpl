{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:GetAccountSettings",
        "lambda:ListLayers",
        "lambda:ListEventSourceMappings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "ManageNASCFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:GetAlias",
        "lambda:UpdateAlias",
        "lambda:DeleteAlias",
        "lambda:ListAliases",
        "lambda:PutFunctionConcurrency",
        "lambda:GetFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig",
        "lambda:ListFunctionEventInvokeConfigs"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:function:nasc-${environment}-*"
    },
    {
      "Sid": "ManageNASCFunctionCode",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:function:nasc-${environment}-*"
    },
    {
      "Sid": "ManageNASCFunctionPermissions",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:function:nasc-${environment}-*"
    },
    {
      "Sid": "ManageNASCFunctionUrls",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:GetFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:ListFunctionUrlConfigs"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:function:nasc-${environment}-*"
    },
    {
      "Sid": "ManageNASCLayers",
      "Effect": "Allow",
      "Action": [
        "lambda:PublishLayerVersion",
        "lambda:ListLayerVersions"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:layer:nasc-${environment}-*"
    },
    {
      "Sid": "ManageNASCLayerVersions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetLayerVersion",
        "lambda:DeleteLayerVersion",
        "lambda:AddLayerVersionPermission",
        "lambda:RemoveLayerVersionPermission",
        "lambda:GetLayerVersionPolicy"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:layer:nasc-${environment}-*:*"
    },
    {
      "Sid": "CreateNASCEventSourceMappings",
      "Effect": "Allow",
      "Action": "lambda:CreateEventSourceMapping",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:${region}:${account_id}:function:nasc-${environment}-*"
        },
        "StringEquals": {
          "aws:RequestedRegion": "${region}",
          "aws:RequestTag/Project": "NASC",
          "aws:RequestTag/Environment": "${environment}"
        }
      }
    },
    {
      "Sid": "ManageNASCEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteEventSourceMapping",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:event-source-mapping:*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:${region}:${account_id}:function:nasc-${environment}-*"
        },
        "StringEquals": {
          "aws:ResourceTag/Project": "NASC",
          "aws:ResourceTag/Environment": "${environment}"
        }
      }
    },
    {
      "Sid": "ReadNASCEventSourceMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:event-source-mapping:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "NASC",
          "aws:ResourceTag/Environment": "${environment}"
        }
      }
    },
    {
      "Sid": "TagNASCEventSourceMappings",
      "Effect": "Allow",
      "Action": "lambda:TagResource",
      "Resource": "arn:aws:lambda:${region}:${account_id}:event-source-mapping:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "NASC",
          "aws:RequestTag/Environment": "${environment}"
        },
        "StringEqualsIfExists": {
          "aws:ResourceTag/Project": "NASC",
          "aws:ResourceTag/Environment": "${environment}"
        }
      }
    },
    {
      "Sid": "ManageNASCEventSourceMappingTags",
      "Effect": "Allow",
      "Action": [
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:${region}:${account_id}:event-source-mapping:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "NASC",
          "aws:ResourceTag/Environment": "${environment}"
        },
        "ForAllValues:StringNotEqualsIgnoreCase": {
          "aws:TagKeys": ["Project", "Environment"]
        }
      }
    }
  ]
}
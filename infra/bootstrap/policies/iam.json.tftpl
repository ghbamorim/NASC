{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListIAMResources",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles",
        "iam:ListInstanceProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadNASCRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListInstanceProfilesForRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/nasc-${environment}-*"
    },
    {
      "Sid": "ReadNASCInstanceProfiles",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::${account_id}:instance-profile/nasc-${environment}-*"
    },
    {
      "Sid": "ReadNASCPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:policy/nasc-${environment}-*",
        "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
      ]
    },
    {
      "Sid": "CreateEC2Role",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::${account_id}:role/nasc-${environment}-ec2-role",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${account_id}:policy/nasc-${environment}-ec2-boundary"
        }
      }
    },
    %{ for operation in ["receive", "process", "send"] ~}
    {
      "Sid": "CreateTelegram${title(operation)}Role",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-${operation}-message",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${account_id}:policy/nasc-${environment}-telegram-${operation}-boundary"
        }
      }
    },
    %{ endfor ~}
    {
      "Sid": "ManageExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/nasc-${environment}-ec2-role",
        "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-receive-message",
        "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-process-message",
        "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-send-message"
      ]
    },
    {
      "Sid": "ManageEC2SSMPolicyAttachment",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/nasc-${environment}-ec2-role",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "ManageEC2InstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::${account_id}:instance-profile/nasc-${environment}-ec2-profile"
    },
    {
      "Sid": "PassEC2Role",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/nasc-${environment}-ec2-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassLambdaRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-send-message",
        "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-process-message",
        "arn:aws:iam::${account_id}:role/nasc-${environment}-telegram-receive-message"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ProtectPermissionsBoundaries",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProtectManagedPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
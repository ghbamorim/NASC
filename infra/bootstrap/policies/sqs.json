{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:SetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": [
        "arn:aws:sqs:${region}:${account_id}:telegram-inbound.fifo",
        "arn:aws:sqs:${region}:${account_id}:telegram-outbound.fifo",
        "arn:aws:sqs:${region}:${account_id}:telegram-inbound-dlq.fifo",
        "arn:aws:sqs:${region}:${account_id}:telegram-outbound-dlq.fifo"
      ]
    }
  ]
}

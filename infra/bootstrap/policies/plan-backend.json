{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTerraformState",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::nasc-terraform-state-242627333067-us-east-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["dev/terraform.tfstate"]
        }
      }
    },
    {
      "Sid": "ReadTerraformState",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::nasc-terraform-state-242627333067-us-east-2/dev/terraform.tfstate"
    }
  ]
}

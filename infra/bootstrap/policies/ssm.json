{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSSM",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeInstanceProperties",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands",
        "ssm:ListDocuments",
        "ssm:DescribeParameters"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "ManageNASCInstances",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:StartSession"],
      "Resource": "arn:aws:ec2:us-east-2:242627333067:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "NASC",
          "ssm:resourceTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "CancelSSMCommands",
      "Effect": "Allow",
      "Action": ["ssm:CancelCommand"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "ManageOwnSessions",
      "Effect": "Allow",
      "Action": ["ssm:TerminateSession", "ssm:ResumeSession"],
      "Resource": "arn:aws:ssm:us-east-2:242627333067:session/${aws:username}-*"
    },
    {
      "Sid": "OpenOwnSessionDataChannel",
      "Effect": "Allow",
      "Action": ["ssmmessages:OpenDataChannel"],
      "Resource": "arn:aws:ssm:us-east-2:242627333067:session/${aws:username}-*"
    },
    {
      "Sid": "ManageNASCDocuments",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:DeleteDocument",
        "ssm:DescribeDocument",
        "ssm:ListDocumentVersions",
        "ssm:GetDocument",
        "ssm:DescribeDocumentPermission",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:us-east-2:242627333067:document/nasc-*"
    },
    {
      "Sid": "UseNASCDocuments",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:StartSession"],
      "Resource": "arn:aws:ssm:us-east-2:242627333067:document/nasc-*"
    },
    {
      "Sid": "ReadAWSManagedDocuments",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeDocument",
        "ssm:GetDocument",
        "ssm:ListDocumentVersions",
        "ssm:DescribeDocumentPermission"
      ],
      "Resource": "arn:aws:ssm:us-east-2::document/AWS-*"
    },
    {
      "Sid": "UseAWSManagedCommandDocuments",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand"],
      "Resource": [
        "arn:aws:ssm:us-east-2::document/AWS-RunShellScript",
        "arn:aws:ssm:us-east-2::document/AWS-RunPowerShellScript",
        "arn:aws:ssm:us-east-2::document/AWS-UpdateSSMAgent",
        "arn:aws:ssm:us-east-2::document/AWS-RunRemoteScript"
      ]
    },
    {
      "Sid": "UseSessionManagerDocuments",
      "Effect": "Allow",
      "Action": ["ssm:StartSession", "ssm:GetDocument", "ssm:DescribeDocument"],
      "Resource": [
        "arn:aws:ssm:us-east-2:242627333067:document/SSM-SessionManagerRunShell",
        "arn:aws:ssm:us-east-2::document/SSM-SessionManagerRunShell",
        "arn:aws:ssm:us-east-2::document/AWS-StartInteractiveCommand",
        "arn:aws:ssm:us-east-2::document/AWS-StartPortForwardingSession",
        "arn:aws:ssm:us-east-2::document/AWS-StartPortForwardingSessionToRemoteHost"
      ]
    },
    {
      "Sid": "ManageNASCParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:GetParameterHistory",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:LabelParameterVersion",
        "ssm:UnlabelParameterVersion",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:us-east-2:242627333067:parameter/nasc/*"
    },
    {
      "Sid": "ReadPublicAMIParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-2::parameter/aws/service/ami-amazon-linux-latest/*",
        "arn:aws:ssm:us-east-2::parameter/aws/service/canonical/ubuntu/*",
        "arn:aws:ssm:us-east-2::parameter/aws/service/ami-windows-latest/*"
      ]
    }
  ]
}
